# GS Control Center — Environment Configuration Template
# Server Target: 10.0.0.111
# NEVER commit real passwords or private keys to version control.

# Application Environment
ENVIRONMENT=production
APP_NAME="GS Control Center"
APP_VERSION="1.0.0"
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WEB_PORT=8088

# Central PostgreSQL 16
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=gs_control_center
POSTGRES_USER=gs_admin
POSTGRES_PASSWORD=generate_a_secure_password_here
DATABASE_URL=postgresql+asyncpg://gs_admin:generate_a_secure_password_here@postgres_db:5432/gs_control_center

# Redis 7 & ARQ Queue
REDIS_HOST=redis_queue
REDIS_PORT=6379
REDIS_URL=redis://redis_queue:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=minio_s3:9000
MINIO_PUBLIC_URL=http://10.0.0.111:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=generate_minio_root_password_here
MINIO_BUCKET_MEDIA=media
MINIO_USE_SSL=false

# Security & JWT Tokens
JWT_SECRET_KEY=generate_jwt_secret_32_bytes_hex_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Master encryption key for Cashier credentials (AES-256-GCM 32-byte hex key)
GS_MASTER_KEY=generate_32_byte_hex_key_here

# Fallback Credentials Vault (AES-256-GCM 32-byte hex key)
CREDENTIAL_ENCRYPTION_KEY=generate_32_byte_hex_key_here

# Corporate SSH Master Key (Base64 encoded Ed25519 or RSA private key)
SSH_MASTER_PRIVATE_KEY_B64=

# Fallback cashier password (if corporate key not yet present on legacy terminal)
CASHIER_FALLBACK_PASSWORD=

# Worker Pool Concurrency Settings
WORKER_CONCURRENCY=15
MAX_CONCURRENT_PER_BRANCH=2
SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=45
SFTP_TIMEOUT_SECONDS=60

# Garbage Collection Retention Settings (Proposed Defaults)
MINIO_MEDIA_RETENTION_DAYS=30
CASHIER_BACKUP_RETENTION_DAYS=7

# Default Timezone
DEFAULT_TIMEZONE=Asia/Tashkent
