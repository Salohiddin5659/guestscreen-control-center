# Central Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authoritative Persistent Database (PostgreSQL 16)
POSTGRES_HOST=10.0.0.111
POSTGRES_PORT=5432
POSTGRES_DB=guestscreen_ad_db
POSTGRES_USER=gs_admin
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Master Cryptographic Secret (CRITICAL: 32 bytes hex or base64)
# MUST NEVER be committed to Git or logged!
GS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Alternatively, point to a protected root file:
# GS_MASTER_KEY_FILE=/etc/guestscreen/master.key

# JWT Operator Authentication
JWT_SECRET=replace_with_random_jwt_signing_secret_min_32_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Media Storage Provider (Decoupled abstraction)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=D:\GuestScreen_Media

# Cashbox Fleet Defaults
DEFAULT_CONCURRENCY_LIMIT=4
HOT_RELOAD_TIMEOUT_SEC=15
SSH_CONNECT_TIMEOUT_SEC=10
SQLITE_BUSY_TIMEOUT_MS=10000
